{
    // 本檔案主要定義了通用 UI 的行為和顯示內容
    // 可參考文件和範例新增更多您需要的功能
    // 文件：https://maafw.xyz/docs/3.3-ProjectInterfaceV2
    // 範例：https://github.com/MaaXYZ/MaaFramework/blob/main/sample/interface.json
    "interface_version": 2,
    "name": "MaaTBH",
    "description": "這是一個使用 MaaFramework 建立的新專案。",
    "contact": "Email: samzx1125@gmail.com",
    "license": "MIT",
    "welcome": "首次使用！歡迎使用 MAA!",
    // 填寫專案地址和版本號可實現自動更新功能
    "github": "https://github.com/samzx1125/MaaTBH",
    "version": "0.0.1",
    "controller": [
        {
            "name": "桌面端",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "TaskBarHero",
                // 截圖及控制方式，請根據專案實際情況修改
                // 文件: https://maafw.xyz/docs/2.4-ControlMethods
                "screencap": "PrintWindow", // 截圖方式
                "mouse": "Seize", // 滑鼠控制方式
                "keyboard": "Seize" // 鍵盤控制方式
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "path": [
                "./resource"
            ]
        }
    ],
    "task": [
        {
            "name": "合成",
            "entry": "Synthesis",
            "default_check": true,
            "option": [
                "SynthesisOptions",
                "InfiniteLoop",
                "LoopCooldown"
            ]
        }
        // ,{
        //     "name": "收取盒子",
        //     "entry": "CollectChest",
        //     "option": [
        //         "任務選項1"
        //     ]
        // }
    ],
    "option": {
        "SynthesisOptions": {
            "type": "checkbox",
            "label": "合成類型",
            "default_case": [
                "option_synthesis_equipment_checkbox",
                "option_synthesis_material_checkbox",
                "option_synthesis_accessory_checkbox"
            ],
            "cases": [
                {
                    "name": "option_synthesis_equipment_checkbox",
                    "label": "裝備",
                    "pipeline_override": {
                        "Synthesis-Equipment": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "option_synthesis_material_checkbox",
                    "label": "材料",
                    "pipeline_override": {
                        "Synthesis-Material": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "option_synthesis_accessory_checkbox",
                    "label": "飾品",
                    "pipeline_override": {
                        "Synthesis-Accessory": {
                            "enabled": true
                        }
                    }
                }
            ]
        },
        "InfiniteLoop": {
            "type": "switch",
            "label": "無限循環",
            "default_case": "No",
            "cases": [
                {
                    "name": "Yes",
                    "label": "開啟",
                    "option": [
                        "LoopCooldown"
                    ],
                    "pipeline_override": {
                        "Synthesis-LoopCooldown": {
                            "enabled": true
                        }
                    }
                },
                {
                    "name": "No",
                    "label": "關閉",
                    "pipeline_override": {
                        "Synthesis-LoopCooldown": {
                            "enabled": false
                        }
                    }
                }
            ]
        },
        "LoopCooldown": {
            "type": "input",
            "label": "循環冷卻時間（秒）",
            "inputs": [
                {
                    "name": "seconds",
                    "label": "秒",
                    "default": "60",
                    "pipeline_type": "int",
                    "verify": "^\\d+$"
                }
            ],
            "pipeline_override": {
                "Synthesis-LoopCooldown": {
                    "args": [
                        "-windowstyle hidden -Command",
                        "Start-Sleep -Seconds {seconds}"
                    ]
                }
            }
        }
    }
}
