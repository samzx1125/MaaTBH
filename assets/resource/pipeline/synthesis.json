{
    "Synthesis": {
        "post_delay": 1000,
        "next": [
            "Synthesis-FocusWindow"
        ],
        "timeout": 5000,
        "on_error": [
            "Synthesis-Equipment-Check"
        ]
    },
    "Synthesis-FocusWindow": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "synthesis/header_cube.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_wait_freezes": 200,
        "next": [
            "Synthesis-FocusWindow-Space",
            "Synthesis-Equipment-Check"
        ]
    },
    "Synthesis-FocusWindow-Space": {
        "enabled": true,
        "action": {
            "type": "ClickKey",
            "param": {
                "key": 32
            }
        },
        "next": [
            "Synthesis-Equipment-Check"
        ]
    },
    "Synthesis-Equipment-Check": {
        "next": [
            "Synthesis-Equipment",
            "Synthesis-Material-Check"
        ]
    },
    "Synthesis-Material-Check": {
        "next": [
            "Synthesis-Material",
            "Synthesis-Accessory-Check"
        ]
    },
    "Synthesis-Accessory-Check": {
        "next": [
            "Synthesis-Accessory",
            "Synthesis-End"
        ]
    },
    "Synthesis-End": {
        "next": [
            "Synthesis-ClickToStash",
            "Synthesis-AfterStash"
        ],
        "timeout": 5000
    },
    "Synthesis-ClickToStash": {
        "enabled": false,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "template": "stash/button_to_stash.png",
                "threshold": 0.95
            }
        },
        "action": {
            "type": "Click",
            "param": {}
        },
        "post_wait_freezes": 300,
        "next": [
            "Synthesis-AfterStash"
        ]
    },
    "Synthesis-AfterStash": {
        "next": [
            "Synthesis-LoopCooldown",
            "Synthesis-Stop"
        ]
    },
    "Synthesis-LoopCooldown": {
        "enabled": false,
        "action": {
            "type": "Command",
            "param": {
                "exec": "powershell",
                "args": [
                    "-NoProfile",
                    "-WindowStyle",
                    "Hidden",
                    "-Command",
                    "Start-Sleep -Seconds (Get-Random -Minimum 240 -Maximum 361)"
                ]
            }
        },
        "next": [
            "Synthesis-FocusWindow"
        ]
    },
    "Synthesis-Stop": {
        "next": []
    },
